# GEMINI_API_KEY: Required for server-side Sylva Intelligence Analyst calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external Earth observation & weather connectors (demo fallback active when unset)
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""
OPENWEATHER_API_KEY=""
GEE_SERVICE_ACCOUNT_JSON=""
GEE_PROJECT_ID=""
